+SOCKET bindSecondaryUdpSocket(unsigned short port, int bufferSize, int socketQosType, struct sockaddr_storage* remoteOut) {
+    const char* env = getenv("NF_MULTIPATH_REMOTE");
+    struct sockaddr_in* sin = (struct sockaddr_in*)remoteOut;
+    SOCKET s;
+
+    if (env == NULL || env[0] == 0) {
+        return INVALID_SOCKET;
+    }
+    memset(remoteOut, 0, sizeof(*remoteOut));
+    sin->sin_family = AF_INET;
+    sin->sin_port = htons(port);
+    if (inet_pton(AF_INET, env, &sin->sin_addr) != 1) {
+        Limelog("Multipath: NF_MULTIPATH_REMOTE is not an IPv4 address: %s\n", env);
+        return INVALID_SOCKET;
+    }
+    s = bindUdpSocket(AF_INET, NULL, 0, bufferSize, socketQosType);
+    if (s != INVALID_SOCKET) {
+        Limelog("Multipath: second path to %s:%u\n", env, (unsigned)port);
+    }
+    return s;
+}
+
+int recvUdpSocketMultipath(SOCKET s, SOCKET s2, char* buffer, int size, bool useSelect) {
+    static _Thread_local int first = 0;
+    struct pollfd pfd[2];
+    int err, i;
+
+    if (s2 == INVALID_SOCKET) {
+        return recvUdpSocket(s, buffer, size, useSelect);
+    }
+    pfd[0].fd = s;
+    pfd[0].events = POLLIN;
+    pfd[0].revents = 0;
+    pfd[1].fd = s2;
+    pfd[1].events = POLLIN;
+    pfd[1].revents = 0;
+    err = pollSockets(pfd, 2, UDP_RECV_POLL_TIMEOUT_MS);
+    if (err <= 0) {
+        return err;
+    }
+    // Alternate which path is read first so neither queue starves; the RTP
+    // queues drop whichever copy arrives second.
+    first ^= 1;
+    for (i = 0; i < 2; i++) {
+        struct pollfd* p = &pfd[(first + i) & 1];
+        if (p->revents & (POLLIN | POLLERR)) {
+            err = (int)recvfrom(p->fd, buffer, size, MSG_DONTWAIT, NULL, NULL);
+            if (err >= 0) {
+                return err;
+            }
+            // ICMP errors from an early ping, or nothing left: try the other path.
+        }
+    }
+    return 0;
+}
+
 SOCKET bindUdpSocket(int addressFamily, struct sockaddr_storage* localAddr, SOCKADDR_LEN addrLen, int bufferSize, int socketQosType) {
     SOCKET s;
     LC_SOCKADDR bindAddr;
