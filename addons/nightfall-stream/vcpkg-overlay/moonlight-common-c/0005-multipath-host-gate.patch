         return INVALID_SOCKET;
     }
     s = bindUdpSocket(AF_INET, NULL, 0, bufferSize, socketQosType);
@@ -315,7 +419,11 @@ int recvUdpSocketMultipath(SOCKET s, SOCKET s2, char* buffer, int size, bool use
     int err, i;
 
