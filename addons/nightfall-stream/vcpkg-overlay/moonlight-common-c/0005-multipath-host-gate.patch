+// Set by the client before each LiStartConnection(); empty = one path only.
+static char MultipathRemote[64];
+static volatile uint64_t MultipathPackets[2];
+
+// Second-path health. Each copy costs airtime and host send capacity, so a
+// path that delivers far less than the main one (a weak Wi-Fi link) can slow
+// the main path down. When it falls behind, its keep-alive pings stop: the
+// host (Nightfall Meteor) stops sending copies to it within a few seconds.
+// It is tried again later, waiting longer after each failure.
+#define MULTIPATH_WINDOW_MS 2000
+#define MULTIPATH_MIN_MAIN_PACKETS 200   // per window: only judge a busy stream
+#define MULTIPATH_BAD_WINDOWS 2          // in a row before pausing
+#define MULTIPATH_PAUSE_MIN_MS 30000
+#define MULTIPATH_PAUSE_MAX_MS 240000
+static volatile int MultipathPaused;
+static uint64_t MultipathWindowStart;
+static uint64_t MultipathWindowMain, MultipathWindowSecond;
+static int MultipathBadWindows;
+static int MultipathSkipWindows;         // after (re)starting: copies resume first
+static uint64_t MultipathPausedUntil;
+static uint64_t MultipathPauseMs;
+
+static void resetMultipathHealth(void) {
+    MultipathPaused = 0;
+    MultipathWindowStart = 0;
+    MultipathBadWindows = 0;
+    MultipathSkipWindows = 1;
+    MultipathPausedUntil = 0;
+    MultipathPauseMs = MULTIPATH_PAUSE_MIN_MS;
+}
+
+bool multipathSecondPathActive(bool evaluate) {
+    uint64_t now, mainPackets, secondPackets, dm, ds;
+
+    if (!evaluate) {
+        return !MultipathPaused;
+    }
+    now = PltGetMillis();
+    mainPackets = MultipathPackets[0];
+    secondPackets = MultipathPackets[1];
+    if (MultipathPaused) {
+        if (now < MultipathPausedUntil) {
+            return false;
+        }
+        Limelog("Multipath: trying the second path again\n");
+        MultipathPaused = 0;
+        MultipathSkipWindows = 1;
+        MultipathWindowStart = 0;
+    }
+    if (MultipathWindowStart == 0) {
+        MultipathWindowStart = now;
+        MultipathWindowMain = mainPackets;
+        MultipathWindowSecond = secondPackets;
+        return true;
+    }
+    if (now - MultipathWindowStart < MULTIPATH_WINDOW_MS) {
+        return true;
+    }
+    dm = mainPackets - MultipathWindowMain;
+    ds = secondPackets - MultipathWindowSecond;
+    MultipathWindowStart = now;
+    MultipathWindowMain = mainPackets;
+    MultipathWindowSecond = secondPackets;
+    if (MultipathSkipWindows > 0) {
+        MultipathSkipWindows--;
+        return true;
+    }
+    if (dm < MULTIPATH_MIN_MAIN_PACKETS) {
+        return true;
+    }
+    if (ds * 2 >= dm) {
+        MultipathBadWindows = 0;
+        MultipathPauseMs = MULTIPATH_PAUSE_MIN_MS;
+        return true;
+    }
+    if (++MultipathBadWindows < MULTIPATH_BAD_WINDOWS) {
+        return true;
+    }
+    Limelog("Multipath: second path delivered %u%% of the main path's packets; pausing it for %us\n",
+            (unsigned)(ds * 100 / dm), (unsigned)(MultipathPauseMs / 1000));
+    MultipathPaused = 1;
+    MultipathBadWindows = 0;
+    MultipathPausedUntil = now + MultipathPauseMs;
+    MultipathPauseMs = MultipathPauseMs * 2 > MULTIPATH_PAUSE_MAX_MS ? MULTIPATH_PAUSE_MAX_MS : MultipathPauseMs * 2;
+    return false;
+}
+
+void LiSetMultipathRemote(const char* address) {
+    if (address == NULL) {
+        address = "";
+    }
+    strncpy(MultipathRemote, address, sizeof(MultipathRemote) - 1);
+    MultipathRemote[sizeof(MultipathRemote) - 1] = 0;
+    MultipathPackets[0] = 0;
+    MultipathPackets[1] = 0;
+    resetMultipathHealth();
+}
+
+void LiGetMultipathPackets(uint64_t* mainPath, uint64_t* secondPath, bool* paused) {
+    *mainPath = MultipathPackets[0];
+    *secondPath = MultipathPackets[1];
+    *paused = MultipathPaused != 0;
+}
