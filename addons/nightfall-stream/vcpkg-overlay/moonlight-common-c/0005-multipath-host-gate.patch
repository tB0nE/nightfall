@@ -335,6 +451,9 @@ int recvUdpSocketMultipath(SOCKET s, SOCKET s2, char* buffer, int size, bool use
         if (p->revents & (POLLIN | POLLERR)) {
             err = (int)recvfrom(p->fd, buffer, size, MSG_DONTWAIT, NULL, NULL);
             if (err >= 0) {
+                // Counts every copy, duplicates included: two equal counts
