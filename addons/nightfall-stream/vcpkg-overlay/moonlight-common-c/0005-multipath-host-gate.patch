 }
 
+// Set by the client before each LiStartConnection(); empty = one path only.
+static char MultipathRemote[64];
+static volatile uint64_t MultipathPackets[2];
+
+// Path health. Each copy costs airtime and host send capacity, so a path that
+// delivers far less than the other (a weak Wi-Fi link) can slow the good one
+// down. The worse path's keep-alive pings stop: the host (Nightfall Meteor)
+// stops sending to it within a few seconds, and keeps the session alive with
+// the other path's pings. Either path can be the weak one. It is tried again
+// later, waiting longer after each failure. Never both at once.
+#define MULTIPATH_WINDOW_MS 2000
+#define MULTIPATH_MIN_PACKETS 200        // per window on the better path: only judge a busy stream
+#define MULTIPATH_BAD_WINDOWS 2          // in a row before pausing
+#define MULTIPATH_PAUSE_MIN_MS 30000
+#define MULTIPATH_PAUSE_MAX_MS 240000
+static volatile int MultipathPausedPath = -1;   // -1 none, 0 main, 1 second
+static uint64_t MultipathWindowStart;
+static uint64_t MultipathWindowPackets[2];
+static int MultipathBadPath = -1;
+static int MultipathBadWindows;
+static int MultipathSkipWindows;         // after (re)starting: copies resume first
+static uint64_t MultipathPausedUntil;
+static uint64_t MultipathPauseMs;
+
+static void resetMultipathHealth(void) {
+    MultipathPausedPath = -1;
+    MultipathWindowStart = 0;
+    MultipathBadPath = -1;
+    MultipathBadWindows = 0;
+    MultipathSkipWindows = 1;
+    MultipathPausedUntil = 0;
+    MultipathPauseMs = MULTIPATH_PAUSE_MIN_MS;
+}
+
+bool multipathPathActive(int path) {
+    return MultipathPausedPath != path;
+}
+
+void multipathEvaluate(void) {
+    uint64_t now = PltGetMillis();
+    uint64_t packets[2] = { MultipathPackets[0], MultipathPackets[1] };
+    uint64_t delta[2];
+    int bad;
+
+    if (MultipathPausedPath >= 0) {
+        if (now < MultipathPausedUntil) {
+            return;
+        }
+        Limelog("Multipath: trying the %s path again\n", MultipathPausedPath == 0 ? "main" : "second");
+        MultipathPausedPath = -1;
+        MultipathSkipWindows = 1;
+        MultipathWindowStart = 0;
+    }
+    if (MultipathWindowStart == 0 || now - MultipathWindowStart >= MULTIPATH_WINDOW_MS) {
+        delta[0] = packets[0] - MultipathWindowPackets[0];
+        delta[1] = packets[1] - MultipathWindowPackets[1];
+        bool judge = MultipathWindowStart != 0;
+        MultipathWindowStart = now;
+        MultipathWindowPackets[0] = packets[0];
+        MultipathWindowPackets[1] = packets[1];
+        if (!judge) {
+            return;
+        }
+        if (MultipathSkipWindows > 0) {
+            MultipathSkipWindows--;
+            return;
+        }
+        if ((delta[0] > delta[1] ? delta[0] : delta[1]) < MULTIPATH_MIN_PACKETS) {
+            return;
+        }
+        bad = delta[1] * 2 < delta[0] ? 1 : (delta[0] * 2 < delta[1] ? 0 : -1);
+        if (bad < 0) {
+            MultipathBadPath = -1;
+            MultipathBadWindows = 0;
+            MultipathPauseMs = MULTIPATH_PAUSE_MIN_MS;
+            return;
+        }
+        if (bad != MultipathBadPath) {
+            MultipathBadPath = bad;
+            MultipathBadWindows = 0;
+        }
+        if (++MultipathBadWindows < MULTIPATH_BAD_WINDOWS) {
+            return;
+        }
+        Limelog("Multipath: %s path delivered %u%% of the other path's packets; pausing it for %us\n",
+                bad == 0 ? "main" : "second", (unsigned)(delta[bad] * 100 / delta[1 - bad]),
+                (unsigned)(MultipathPauseMs / 1000));
+        MultipathPausedPath = bad;
+        MultipathBadPath = -1;
+        MultipathBadWindows = 0;
+        MultipathPausedUntil = now + MultipathPauseMs;
+        MultipathPauseMs = MultipathPauseMs * 2 > MULTIPATH_PAUSE_MAX_MS ? MULTIPATH_PAUSE_MAX_MS : MultipathPauseMs * 2;
+    }
+}
+
+void LiSetMultipathRemote(const char* address) {
+    if (address == NULL) {
+        address = "";
+    }
+    strncpy(MultipathRemote, address, sizeof(MultipathRemote) - 1);
+    MultipathRemote[sizeof(MultipathRemote) - 1] = 0;
+    MultipathPackets[0] = 0;
+    MultipathPackets[1] = 0;
+    resetMultipathHealth();
+}
+
+void LiGetMultipathPackets(uint64_t* mainPath, uint64_t* secondPath, int* pausedPath) {
+    *mainPath = MultipathPackets[0];
+    *secondPath = MultipathPackets[1];
+    *pausedPath = MultipathPausedPath;
+}
