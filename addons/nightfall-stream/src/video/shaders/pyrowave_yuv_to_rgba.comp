#version 450

// PyroWave decodes to planar YCbCr 4:2:0; GLES samples the result as plain RGB
// (color_matrix_type == 3). The math must match yuv_display_core.gdshaderinc's
// planar path (yuv_mode == 3, color_range == 0, color_matrix_type == 1):
// BT.709 limited range, bilinear chroma via normalized UVs.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D tex_y;
layout(set = 0, binding = 1) uniform sampler2D tex_cb;
layout(set = 0, binding = 2) uniform sampler2D tex_cr;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D out_rgba;

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(out_rgba);
	if (p.x >= size.x || p.y >= size.y)
		return;

	vec2 uv = (vec2(p) + 0.5) / vec2(size);
	float y_raw = texelFetch(tex_y, p, 0).r;
	float u_raw = texture(tex_cb, uv).r;
	float v_raw = texture(tex_cr, uv).r;

	float y = (y_raw - 16.0 / 255.0) * (255.0 / 219.0);
	float u = (u_raw - 128.0 / 255.0) * (255.0 / 224.0);
	float v = (v_raw - 128.0 / 255.0) * (255.0 / 224.0);

	vec3 rgb;
	rgb.r = y + 1.5748 * v;
	rgb.g = y - 0.1873 * u - 0.4681 * v;
	rgb.b = y + 1.8556 * u;

	imageStore(out_rgba, p, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
