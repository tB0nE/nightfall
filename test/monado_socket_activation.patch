--- a/src/xrt/ipc/server/ipc_server_mainloop_linux.c
+++ b/src/xrt/ipc/server/ipc_server_mainloop_linux.c
@@ -26,6 +26,7 @@
 
 #include "shared/ipc_shmem.h"
 #include "server/ipc_server.h"
+#include "meteor_xr_listen_fd.h"
 
 #include <stdlib.h>
 #include <unistd.h>
@@ -158,7 +159,20 @@
 	int ret;
 	ml->listen_socket = -1;
 
