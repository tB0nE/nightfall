extends SceneTree

const Session = preload("res://src/pcvr_session.gd")

func _init() -> void:
	_test_success()
	_test_preparation_failure()
	_test_cancel_and_late_callbacks()
	_test_failure_and_retry()
	print("All pcvr_session tests passed")
	quit()

func _expect(commands: Array[Dictionary], action: String, token: int) -> void:
	assert(commands == [{"action": action, "generation": token}])

func _ownership(session: RefCounted, exclusive: bool, owned: bool) -> void:
	assert(session.is_exclusive() == exclusive)
	assert(session.owns_input() == owned)
	assert(session.owns_presentation() == owned)

func _test_success() -> void:
	var session = Session.new()
	assert(session.state == Session.State.IDLE)
	_ownership(session, false, false)
	assert(session.exit().is_empty())
	assert(session.fail(0, "idle failure").is_empty())
	_expect(session.enter(), "prepare_exclusive", 1)
	_ownership(session, true, false)
	assert(session.enter().is_empty())
	assert(session.generation == 1)
	assert(session.connected(1).is_empty())
	assert(session.state == Session.State.PREPARING)
	_expect(session.preparation_finished(1, true), "connect", 1)
	assert(session.state == Session.State.CONNECTING)
	_ownership(session, true, false)
	assert(session.enter().is_empty())
	assert(session.preparation_finished(1, true).is_empty())
	session.connected(1)
	assert(session.state == Session.State.RUNNING)
	_ownership(session, true, true)
	assert(session.enter().is_empty())
	assert(session.connected(1).is_empty())
	_expect(session.exit(), "stop", 2)
	_ownership(session, true, false)
	assert(session.state == Session.State.STOPPING)
	assert(session.enter().is_empty())
	assert(session.exit().is_empty())
	assert(session.fail(2, "late failure").is_empty())
	assert(session.stopped(1).is_empty())
	_expect(session.stopped(2), "show_welcome", 2)
	assert(session.state == Session.State.IDLE)
	_ownership(session, false, false)
	assert(session.stopped(2).is_empty())
	assert(session.exit().is_empty())

func _test_preparation_failure() -> void:
	var session = Session.new()
	session.enter()
	_expect(session.preparation_finished(1, false, "cleanup failed"), "stop", 2)
	assert(session.error == "cleanup failed")
	assert(session.state == Session.State.STOPPING)
	session.reset()
	assert(session.state == Session.State.STOPPING)
	assert(session.preparation_finished(1, true).is_empty())
	assert(session.connected(1).is_empty())
	_expect(session.stopped(2), "show_welcome", 2)
	assert(session.state == Session.State.FAILED)
	_ownership(session, false, false)
	assert(session.enter().is_empty())
	assert(session.exit().is_empty())
	assert(session.fail(2, "duplicate").is_empty())
	assert(session.error == "cleanup failed")
	session.reset()
	assert(session.error.is_empty())
	_expect(session.enter(), "prepare_exclusive", 3)

func _test_cancel_and_late_callbacks() -> void:
	for during_connect in [false, true]:
		var session = Session.new()
		session.enter()
		if during_connect:
			session.preparation_finished(1, true)
		_expect(session.exit(), "stop", 2)
		assert(session.preparation_finished(1, true).is_empty())
		assert(session.preparation_finished(1, false).is_empty())
		assert(session.connected(1).is_empty())
		assert(session.fail(1, "old error").is_empty())
		assert(session.state == Session.State.STOPPING)
		assert(session.exit().is_empty())
		_expect(session.stopped(2), "show_welcome", 2)
		_expect(session.enter(), "prepare_exclusive", 3)
		assert(session.stopped(2).is_empty())
		assert(session.preparation_finished(1, true).is_empty())
		assert(session.connected(1).is_empty())
		assert(session.fail(1, "previous attempt").is_empty())
		assert(session.state == Session.State.PREPARING)
		_expect(session.preparation_finished(3, true), "connect", 3)
		session.connected(3)
		assert(session.state == Session.State.RUNNING)

func _test_failure_and_retry() -> void:
	for running in [false, true]:
		var session = Session.new()
		session.enter()
		session.preparation_finished(1, true)
		if running:
			session.connected(1)
		_expect(session.fail(1, "remote lost"), "stop", 2)
		_ownership(session, true, false)
		assert(session.fail(1, "duplicate").is_empty())
		assert(session.fail(2, "duplicate teardown error").is_empty())
		assert(session.exit().is_empty())
		assert(session.connected(1).is_empty())
		_expect(session.stopped(2), "show_welcome", 2)
		assert(session.state == Session.State.FAILED)
		assert(session.stopped(2).is_empty())
		session.reset()
		session.reset()
		assert(session.state == Session.State.IDLE)
		_expect(session.enter(), "prepare_exclusive", 3)
		_expect(session.preparation_finished(3, true), "connect", 3)
		session.connected(3)
		_expect(session.exit(), "stop", 4)
		# Exact command assertions on every terminal path prohibit reopening any
		# previous stream/browser: welcome is the sole completion command.
		_expect(session.stopped(4), "show_welcome", 4)
