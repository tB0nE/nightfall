+    #[test]
+    fn concurrent_injected_reads_share_the_same_interface() {
+        let core = ClientCore::new(c"IVRClientCore_003").unwrap();
+        core.try_interface(c"one", |_| Interface1);
+        let expected = core.get_interface::<Interface1>().unwrap();
+        for _ in 0..64 {
+            let injected = Arc::new(Injected::<Interface1> {
+                item: OnceLock::new(),
+                store: core.interface_store.clone(),
+                _marker: Default::default(),
+            });
+            let barrier = Arc::new(std::sync::Barrier::new(16));
+            std::thread::scope(|scope| {
+                for _ in 0..16 {
+                    let injected = injected.clone();
+                    let barrier = barrier.clone();
+                    let expected = expected.clone();
+                    scope.spawn(move || {
+                        barrier.wait();
+                        assert!(Arc::ptr_eq(&injected.get().unwrap(), &expected));
+                    });
+                }
+            });
+        }
+    }
