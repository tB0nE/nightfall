+static xrt_result_t
+simulated_meteor_view_poses(struct xrt_device *xdev,
+                            const struct xrt_vec3 *default_eye_relation,
+                            int64_t at_timestamp_ns,
+                            enum xrt_view_type view_type,
+                            uint32_t view_count,
+                            struct xrt_space_relation *out_head_relation,
+                            struct xrt_fov *out_fovs,
+                            struct xrt_pose *out_poses)
+{
+	xrt_result_t result = u_device_get_view_poses(xdev, default_eye_relation, at_timestamp_ns,
+	                                               view_type, view_count, out_head_relation, out_fovs, out_poses);
+	if (result == XRT_SUCCESS && view_count == 2) {
+		meteor_tracking_eye_geometry(&simulated_hmd(xdev)->meteor_tracking, xdev, out_fovs, out_poses);
+	}
+	return result;
+}
+
+static xrt_result_t
+simulated_meteor_visibility_mask(struct xrt_device *xdev,
+                                enum xrt_visibility_mask_type type,
+                                uint32_t view_index,
+                                struct xrt_visibility_mask **out_mask)
+{
+	(void)xdev;
+	(void)view_index;
+	// The remote headset supplies its FOV, not its lens visibility mesh.
+	// A simulated HMD's generic corner mask is not valid for that headset.
+	// Return no mask so the game renders the complete submitted eye rectangle.
+	u_visibility_mask_get_noop(type, out_mask);
+	return *out_mask != NULL ? XRT_SUCCESS : XRT_ERROR_ALLOCATION;
+}
