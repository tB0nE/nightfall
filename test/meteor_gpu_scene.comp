#version 450
// GPU equivalent of meteor_pose_scene.h. Diagnostic only; no CPU pixel upload.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,std430) writeonly buffer Pixels { uint pixels[]; };
layout(push_constant) uniform Camera {
    vec4 origin;
    vec4 basis_x;
    vec4 basis_y;
    vec4 basis_z;
    vec4 tangents; // left, right, up, down
    uvec4 extent;
} camera;
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(p,camera.extent.xy))) return;
    vec2 uv=(vec2(p)+0.5)/vec2(camera.extent.xy);
    vec3 ray=normalize(camera.basis_x.xyz*mix(camera.tangents.x,camera.tangents.y,uv.x)
        +camera.basis_y.xyz*mix(camera.tangents.z,camera.tangents.w,uv.y)+camera.basis_z.xyz);
    vec3 origin=camera.origin.xyz;
    float sky=clamp(ray.y*0.5+0.5,0.0,1.0);
    vec3 color=vec3(.03,.04,.07)+vec3(.08,.12,.17)*sky;
    float nearest=1000.0;
    if(ray.y<-.001) {
        float t=(-1.5-origin.y)/ray.y;
        if(t>0.0 && t<80.0) {
            vec3 hit=origin+ray*t;
            int square=int(floor(hit.x))+int(floor(hit.z));
            color=vec3((square%2)!=0 ? .20 : .08); nearest=t;
        }
    }
    const vec3 colors[3]=vec3[3](vec3(.9,.18,.12),vec3(.12,.8,.3),vec3(.15,.35,.95));
    for(int i=0;i<3;++i) {
        vec3 center=vec3(float(i-1)*1.4,0,-3.0-float(i)*.5);
        vec3 offset=origin-center;
        float b=dot(offset,ray), d=b*b-(dot(offset,offset)-.36);
        if(d>0.0) {
            float t=-b-sqrt(d);
            if(t>0.0 && t<nearest) {
                vec3 normal=(origin+ray*t-center)/.6;
                color=colors[i]*(.25+.75*max(0.0,dot(normal,vec3(-.4,.7,.5)))); nearest=t;
            }
        }
    }
    uvec3 rgb=uvec3(clamp(color,0.0,1.0)*255.0);
    pixels[p.y*camera.extent.x+p.x]=rgb.r|(rgb.g<<8)|(rgb.b<<16)|0xff000000u;
}
