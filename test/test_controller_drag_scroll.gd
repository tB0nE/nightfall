extends SceneTree

func _init():
	var scroll := ControllerDragScroll.new()
	assert(scroll.step(false, 0.0, "screenA", true, 0) == 0)
	assert(scroll.step(true, 0.0, "screenA", true, 1) == 0)
	assert(scroll.active and scroll.consuming)
	assert(not scroll.is_new_press(true), "A held grip must not reposition the host pointer")
	assert(scroll.step(true, 0.003, "screenA", true, 20) == 0)
	assert(scroll.step(true, 0.01, "screenA", true, 40) == 0)
	assert(scroll.step(true, 0.06, "screenA", true, 60) < 0, "Upward drag scrolls down")
	assert(scroll.step(true, 0.12, "screenA", true, 61) == 0, "Rate limit batches deltas")
	assert(scroll.step(true, 0.13, "screenA", true, 80) < 0)
	assert(scroll.step(true, 0.3, "screenB", true, 100) == 0)
	assert(not scroll.active and scroll.consuming, "Target change cancels but still owns the held grip")
	assert(scroll.step(true, 0.3, "screenA", true, 120) == 0)
	scroll.step(false, 0.3, "screenA", true, 140)
	assert(not scroll.consuming)
	scroll.step(true, 0.3, "screenA", false, 160)
	scroll.step(true, 0.3, "screenA", true, 180)
	assert(not scroll.active, "Entering a screen with grip already held must not start scrolling")
	scroll.step(false, 0.3, "screenA", true, 200)
	scroll.step(true, 0.3, "screenA", true, 220)
	scroll.cancel()
	scroll.step(true, 0.4, "screenA", true, 240)
	assert(not scroll.active, "Pause cancellation requires release")
	scroll.step(false, 0.0, "screenA", true, 260)
	scroll.step(true, NAN, "screenA", true, 280)
	assert(not scroll.active)
	var config := ConfigFile.new()
	var settings := AppSettings.new()
	assert(not settings.grip_scroll_enabled)
	settings.grip_scroll_enabled = true
	SettingsPersistence.write_app(config, settings)
	var restored := AppSettings.new()
	SettingsPersistence.read_app(config, restored, false, [0])
	assert(restored.grip_scroll_enabled)
	restored.reset_general()
	assert(not restored.grip_scroll_enabled)
	print("All controller drag scroll tests passed")
	quit()
