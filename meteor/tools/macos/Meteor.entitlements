<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Meteor and its host (build_macos_app.sh). -->
<plist version="1.0">
<dict>
  <!-- The host can capture an audio input device instead of the system audio tap. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
