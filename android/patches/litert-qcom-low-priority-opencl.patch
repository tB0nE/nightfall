diff --git a/tensorflow/lite/delegates/gpu/cl/cl_context.cc b/tensorflow/lite/delegates/gpu/cl/cl_context.cc
index f1af858790..d97c55a10a 100644
--- a/tensorflow/lite/delegates/gpu/cl/cl_context.cc
+++ b/tensorflow/lite/delegates/gpu/cl/cl_context.cc
@@ -17,0 +18,4 @@ limitations under the License.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
@@ -27,0 +32,3 @@ namespace {
+constexpr cl_context_properties kContextPriorityHintQcom = 0x40C9;
+constexpr cl_context_properties kPriorityHintLowQcom = 0x40CC;
+
@@ -138,0 +146,19 @@ absl::Status CreateCLContext(const CLDevice& device, CLContext* result) {
+  // The setting is process-local and is written by Nightfall before it
+  // constructs a new GPU delegate. An existing OpenCL context cannot change
+  // priority, so switching modes recreates the interpreter/delegate. Default
+  // to stream priority when older app code does not set the variable.
+  const char* requested = std::getenv("NIGHTFALL_LITERT_GPU_PRIORITY");
+  const bool stream_priority =
+      requested == nullptr || std::strcmp(requested, "default") != 0;
+  if (stream_priority &&
+      device.GetInfo().SupportsExtension("cl_qcom_priority_hint")) {
+    cl_context_properties platform =
+        reinterpret_cast<cl_context_properties>(device.platform());
+    cl_context_properties properties[] = {
+        kContextPriorityHintQcom, kPriorityHintLowQcom,
+        CL_CONTEXT_PLATFORM, platform, 0};
+    std::fprintf(stderr,
+                 "Nightfall LiteRT: creating STREAM-priority Qualcomm OpenCL context\n");
+    return CreateCLContext(device, properties, result);
+  }
+  std::fprintf(stderr, "Nightfall LiteRT: creating DEFAULT-priority OpenCL context\n");
